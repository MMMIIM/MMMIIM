# Gateway-owned local runtime configuration. Copy to .env; never commit .env.
SEMANTIC_GATEWAY_PROVIDER=openai_compatible
SEMANTIC_GATEWAY_API_BASE=http://127.0.0.1:18082
SEMANTIC_GATEWAY_API_KEY=
SEMANTIC_GATEWAY_PROVIDER_API_BASE=https://api.siliconflow.cn/v1
SEMANTIC_GATEWAY_PROVIDER_API_KEY=
SEMANTIC_GATEWAY_MODEL=Qwen/Qwen2.5-7B-Instruct
SEMANTIC_GATEWAY_TIMEOUT_MS=120000
SEMANTIC_GATEWAY_HOST=127.0.0.1
SEMANTIC_GATEWAY_PORT=18082
DEEPSEEK_OFFICIAL_API_KEY=
# Configure locally. Never commit real credentials.
DEEPSEEK_OFFICIAL_API_BASE=https://api.deepseek.com
DEEPSEEK_OFFICIAL_FACT_MODEL=deepseek-v4-pro
