# 后端环境变量请复制到 backend/.env
DIFY_API_BASE=https://api.dify.ai/v1
DIFY_API_KEY=
DIFY_WORKFLOW_VERSION=4.2
GENERATION_PROVIDER=mock
V43_GATEWAY_API_BASE=
V43_GATEWAY_API_KEY=
V43_GATEWAY_USER=
V43_GATEWAY_TIMEOUT_MS=30000
V43_GATEWAY_HEALTHCHECK_TIMEOUT_MS=15000
V43_GATEWAY_REQUIREMENT_EXTRACTION_TIMEOUT_MS=300000
SEMANTIC_GATEWAY_PROVIDER=mock
SEMANTIC_GATEWAY_API_KEY=
SEMANTIC_GATEWAY_MODEL=mock-semantic-v1
SEMANTIC_GATEWAY_PROVIDER_API_BASE=
SEMANTIC_GATEWAY_PROVIDER_API_KEY=
SEMANTIC_GATEWAY_TIMEOUT_MS=120000
REQUIREMENT_SINGLE_CALL_CHAR_THRESHOLD=2000
REQUIREMENT_CHUNK_CHAR_BUDGET=2000
REQUIREMENT_CHUNK_TOKEN_BUDGET=8000
REQUIREMENT_CHUNK_SOURCE_SPAN_BUDGET=100
DATABASE_URL=postgresql://bid_user:bid_password@127.0.0.1:5432/bid_platform
V43_EMBEDDING_API_BASE=
V43_EMBEDDING_API_KEY=
V43_EMBEDDING_MODEL=text-embedding-3-small
V43_EMBEDDING_VERSION=1
V43_EMBEDDING_DIMENSION=1536
V43_EMBEDDING_TIMEOUT_MS=30000
# Development-only optional SOCKS5 transport; leave empty for direct HTTPS.
EMBEDDING_PROXY_URL=
# Development-only managed SSH transport. Set an existing ~/.ssh/config alias or target outside Git.
RUNTIME_SSH_TARGET=
RUNTIME_GATEWAY_LOCAL_PORT=18080
RUNTIME_EMBEDDING_SOCKS_PORT=18081
V43_RETRIEVAL_TOP_K=5
UPLOAD_DIR=../uploads
PORT=3001
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173
