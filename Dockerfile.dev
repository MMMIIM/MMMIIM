FROM node:22-bookworm-slim

WORKDIR /app

# Copy workspace manifests first so dependency installation is cached while
# source edits continue to invalidate only the final layer.
COPY package.json package-lock.json ./
COPY backend/package.json backend/package.json
COPY frontend/package.json frontend/package.json
COPY packages/semantic-contracts/package.json packages/semantic-contracts/package.json
COPY services/semantic-gateway/package.json services/semantic-gateway/package.json
RUN npm ci --ignore-scripts

COPY . /app

ENV NODE_ENV=development
