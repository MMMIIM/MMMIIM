      "raw_html_navigation_term_count": 15,
      "input_unit_indicator": "MULTI_PAGE_OR_SITE_AGGREGATED_INDICATORS",
      "classification_counts": {
        "LIKELY_SUBSTANTIVE": 3,
        "LIKELY_NAVIGATION": 17,
        "LIKELY_INDEX": 0,
        "LIKELY_BOILERPLATE": 1,
