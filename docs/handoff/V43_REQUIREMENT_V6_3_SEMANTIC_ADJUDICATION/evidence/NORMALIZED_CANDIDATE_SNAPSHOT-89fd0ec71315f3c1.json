        },
        "mandatory_observed": true,
        "requires_confirmation": false
      },
      {
        "text": "投标文件必须包含资格证明文件。",
        "category": "delivery",
        "source_range": {
          "start_ref": "C003-S011",
          "end_ref": "C003-S011"
