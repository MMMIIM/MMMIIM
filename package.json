{
  "name": "ai-bid-response-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:full": "node scripts/dev-full.js",
    "backend:dev": "npm run dev -w backend",
    "frontend:dev": "npm run dev -w frontend",
    "semantic-gateway:start": "powershell -ExecutionPolicy Bypass -File services/semantic-gateway/scripts/start.ps1",
    "runtime:bootstrap": "node scripts/runtime-bootstrap.js",
    "runtime:up": "node scripts/runtime-bootstrap.js",
    "runtime:refresh": "node scripts/runtime-bootstrap.js --refresh",
    "runtime:recreate": "node scripts/runtime-recreate.js",
    "runtime:status": "node scripts/runtime-docker.js ps",
    "runtime:logs": "node scripts/runtime-docker.js logs --tail=200 backend semantic-gateway",
    "runtime:restart:gateway": "node scripts/runtime-docker.js up -d --build --force-recreate semantic-gateway",
    "runtime:restart:backend": "node scripts/runtime-docker.js up -d --build --force-recreate backend",
    "runtime:stop": "node scripts/runtime-docker.js stop postgres semantic-gateway backend",
    "runtime:docker-status": "node scripts/runtime-docker.js ps",
    "runtime:health": "node scripts/runtime-health.js",
    "runtime:wait": "node scripts/runtime-health.js --wait",
    "runtime:diagnose": "node scripts/runtime-health.js --diagnose",
    "reqx:doctor": "npm run reqx:doctor -w backend",
    "reqx:accept": "npm run reqx:accept -w backend",
    "reqx:live": "npm run reqx:live -w backend --",
    "check:semantic-gateway": "npm run check:semantic-gateway -w backend",
    "check:runtime-config": "npm run check:runtime-config -w backend",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "test": "npm run test -w backend && npm run test -w frontend",
    "lint": "npm run lint --if-present -w backend && npm run lint --if-present -w frontend"
  },
  "dependencies": {
    "concurrently": "^9.2.4"
  },
  "overrides": {
    "body-parser": "1.20.6",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "shell-quote": "1.10.0"
  }
}
